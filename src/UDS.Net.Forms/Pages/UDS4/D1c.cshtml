@page "{id:int?}"
@model UDS.Net.Forms.Pages.UDS4.D1cModel
@{
    Layout = "_LayoutForm";
    string rowCSS = "sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:py-6";
}

<div>
    <p class="mt-1 text-sm text-gray-500">
        INSTRUCTIONS: This form is to be completed by the clinician for all participants to record biological and clinical staging of Alzheimer's disease. For additional clarification and examples, see <guidebook kind="@Model.Visit.PACKET"></guidebook>, <strong>Form D1c</strong>. Check only <span class="underline">one</span> box per question unless otherwise indicated.
    </p>
</div>

<div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4 sm:py-6 subcounterreset">
    <label asp-for="D1c.DXPLSMABIO"><span class="counter"></span> @Html.DisplayNameFor(m => m.D1c.DXPLSMABIO)</label>
    <div class="mt-4 sm:col-span-2 sm:mt-0">
        <p class="text-sm text-gray-500" asp-description-for="@Model.D1c.DXPLSMABIO"></p>
        <radio-button-group id="@Html.IdFor(m => m.D1c.DXPLSMABIO)" for="@Model.D1c.DXPLSMABIO" items="Model.SimpleNoYesListItems" ui-behaviors="Model.DXPLSMABIOUIBehavior"></radio-button-group>
        <span class="mt-2 text-sm text-red-600" asp-validation-for="D1c.DXPLSMABIO"></span>
        <submission-error location="DXPLSMABIO" errors="Model.BaseForm.UnresolvedErrors" />
    </div>
</div>

