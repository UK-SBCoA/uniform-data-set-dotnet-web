        <p class="ml-2 mt-1 truncate font-semibold leading-6 text-indigo-900">
            Amyloid PET
        </p>
    </div>

    <div class="ml-2 space-y-4">
        <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4">
            <label class="text-sm font-medium text-gray-900">Amyloid PET Result</label>
            <div class="mt-2 sm:col-span-2">
                <radio-button-group id="@Html.IdFor(m => m.D1c.APETRS)" for="@Model.D1c.APETRS" items="Model.PETFindingsListItems"></radio-button-group>
                <span class="mt-2 text-sm text-red-600" asp-validation-for="D1c.APETRS"></span>
            </div>
        </div>

        <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4">
            <label class="text-sm font-medium text-gray-900">How obtained?</label>
            <div class="mt-2 sm:col-span-2 space-y-2">
                <div class="flex items-center">
                    <input type="checkbox" id="@Html.IdFor(m => m.D1c.APETVIS)" name="@Html.NameFor(m => m.D1c.APETVIS)" value="1" @(Model.D1c.APETVIS == 1 ? "checked" : "") class="h-4 w-4 rounded border-gray-400" />
                    <label for="@Html.IdFor(m => m.D1c.APETVIS)" class="ml-2 text-sm text-gray-900">Visual Read</label>
                </div>
                <div class="flex items-center">
                    <input type="checkbox" id="@Html.IdFor(m => m.D1c.APETQUANT)" name="@Html.NameFor(m => m.D1c.APETQUANT)" value="1" @(Model.D1c.APETQUANT == 1 ? "checked" : "") class="h-4 w-4 rounded border-gray-400" />
                    <label for="@Html.IdFor(m => m.D1c.APETQUANT)" class="ml-2 text-sm text-gray-900">Quantitative</label>
                </div>
            </div>
        </div>

        <div class="sm:grid sm:grid-cols-3 sm:items-start sm:gap-4">
            <label class="text-sm font-medium text-gray-900">Where obtained?</label>
            <div class="mt-2 sm:col-span-2">
                <radio-button-group id="@Html.IdFor(m => m.D1c.APETANLYS)" for="@Model.D1c.APETANLYS" items="Model.AnalysisLocationListItems"></radio-button-group>
                <span class="mt-2 text-sm text-red-600" asp-validation-for="D1c.APETANLYS"></span>
            </div>
        </div>

