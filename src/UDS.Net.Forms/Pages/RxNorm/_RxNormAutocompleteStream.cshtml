@model RxNormLookupModel
@{
}

<turbo-stream action="update" target="options">
    <template>

        @if (Model?.AutocompleteResults?.Any() == true)
        {
            for (int i = 0; i < Model.AutocompleteResults.Count(); i++)
            {
                <li data-rxNormDisplayNames-target="item"
                    data-action="mousedown->rxNormDisplayNames#select"
                    data-item='@Json.Serialize(Model.AutocompleteResults[i])'
                    class="cursor-default text-gray-900 hover:bg-indigo-600 hover:text-white rounded-md px-4 py-2 select-none"
                    id="option-@i"
                    role="option"
                    tabindex="-1">

                    @Model.AutocompleteResults[i]

                </li>
            }

            if (Model.ResultsCount == 100)
            {
                <li class="text-gray-400 rounded-md px-4 py-2 select-none">
                    More than @Model.ResultsCount results, continue typing
                </li>
            }
        }
        else
        {
            <li class="px-4 py-2 text-gray-500 italic">
                No results
            </li>
        }

    </template>
</turbo-stream>