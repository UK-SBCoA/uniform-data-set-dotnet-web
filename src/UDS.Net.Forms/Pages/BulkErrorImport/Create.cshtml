@page
@model UDS.Net.Forms.Pages.BulkErrorImport.CreateModel

@{
    var bulkErrorSubmissionItemIndex = 0;
}

<turbo-frame id="BulkErrorImport">
    <form method="post" asp-page-handler="ConfirmBulkImport" data-controller="bulkImport">
        <div class="flex justify-center py-3">
            <div asp-validation-summary="All" class="mt-2 text-sm text-red-600"></div>
        </div>
        <div class="px-16">
            <div class="text-right px-5">
                <a data-action="click->bulkImport#CollapseAll">
                    Collapse All
                </a>
            </div>
            <div class="grid grid-cols-1 p-3 rounded-md min-h-16 bg-gray-200 px-3 py-2 text-sm font-semibold text-black shadow-sm">
                <div class="pb-3">
                    Packets in Submitted Status
                </div>
                @foreach (var packet in Model.PacketsToDisplay)
                {
                    var activeSubmission = packet.GetActiveSubmission;

                    <div class="py-3">
                        <div class="border border-gray-600 flex p-4 bg-white">
                            <div class="w-14">
                                @if (activeSubmission.ErrorCount > 0) {
                                    <input name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].ConfirmImport" class="h-5 w-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" data-bulkImport-target="submissionGroupConfirm" type="checkbox" checked value="true" />
                                    <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].ConfirmImport" value="false" />
                                }
                            </div>
                            <div class="w-64" data-bulkImport-target="ptidGroup" data-bulk-error-submission-item-index="@bulkErrorSubmissionItemIndex">
                                PTID: @packet.PacketToImport.ParticipationId
                            </div>
                            <div class="w-64">
                                Visit: @packet.PacketToImport.VISITNUM
                            </div>
                            <div class="w-64">
                                Packet: @packet.PacketToImport.PACKET
                            </div>
                            <div class="w-64">
                                @(activeSubmission.ErrorCount > 0 ? $"Error Count: {@activeSubmission.ErrorCount}" : "")
                            </div>
                            @if(activeSubmission.ErrorCount > 0) {
                                <div class="flex-1 flex justify-end">
                                    <a data-action="click->bulkImport#ToggleErrorDisplay" data-bulkImport-submission-index-param="@bulkErrorSubmissionItemIndex">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                        </svg>
                                    </a>
                                </div>
                            }
                        </div>

                        @{
                            var bulkErrorSubmissionErrorIndex = 0;
                        }

                        @if (activeSubmission.ErrorCount > 0)
                        {
                            <div class="mt-3 py-5 px-5 bg-white" data-bulkImport-target="window" data-submission-index="@bulkErrorSubmissionItemIndex" hidden>
                                <table class="w-full">
                                    <thead>
                                        <tr class="text-left">
                                            <th>Location</th>
                                            <th>Message</th>
                                            <th>Value</th>
                                            <th>Level</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var error in activeSubmission.Errors)
                                        {
                                            <tr>
                                                <td class="py-5">@error.FormKind - @error.Location</td>
                                                <td class="py-5">@error.Message</td>
                                                <td class="py-5">@error.Value</td>
                                                <td class="py-5">
                                                    <div class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium @(error.Level.ToString().ToLower() == "error" ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800")">
                                                        @error.Level
                                                    </div>
                                                </td>
                                                <td class="py-5">
                                                    <div>
                                                        @if(error.Level.ToString().ToLower() == "error"){
                                                            @error.Status
                                                        }
                                                        else
                                                        {
                                                            <select data-bulkImport-target="errorStatus" data-bulk-error-submission-item-index="@bulkErrorSubmissionItemIndex" data-action="change->bulkImport#SetPacketStatusByAlertStatus" class="block rounded-md border-0 py-1.5 pl-3 pr-10 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm sm:leading-6 never-enable" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].Status">
                                                                <option value="0">Pending</option>
                                                                <option value="1">Resolved</option>
                                                                <option value="2">Ignored</option>
                                                            </select>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>

                                            @* hidden input for packet status *@
                                            //DEVNOTE: Set up the javascript to set this value when the checkbox is clicked
                                            //Check each error in a group and if none of them are "Pending", then set the input to PassedErrorChecks
                                            <input data-bulkImport-target="packetStatus" data-bulk-error-submission-item-index="@bulkErrorSubmissionItemIndex" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].PacketStatus" value="FailedErrorChecks" />

                                            @* hidden  inputs for the NACC errors *@
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].Id" value="@error.Id" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].PacketSubmissionId" value="@error.PacketSubmissionId" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].FormKind" value="@error.FormKind" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].Message" value="@error.Message" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].AssignedTo" value="@error.AssignedTo" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].Level" value="@error.Level" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].StatusChangedBy" value="@error.StatusChangedBy" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].Location" value="@error.Location" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].Value" value="@error.Value" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].CreatedAt" value="@error.CreatedAt" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].CreatedBy" value="@error.CreatedBy" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].ModifiedBy" value="@error.ModifiedBy" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].DeletedBy" value="@error.DeletedBy" />
                                            <input type="hidden" name="BulkErrorSubmissionItems[@bulkErrorSubmissionItemIndex].SubmissionErrors[@bulkErrorSubmissionErrorIndex].IsDeleted" value="@error.IsDeleted" />

                                            @* increment the NACCErrorIndex *@
                                            bulkErrorSubmissionErrorIndex++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    bulkErrorSubmissionItemIndex++;
                }
            </div>
            <div class="pt-4 flex gap-x-3">
                <div>
                    <input data-action="click->bulkImport#SetPacketStatusByAlertStatus click->bulkImport#HandleIgnoredResolved" data-bulkImport-target="ignoreResolvedCheckbox" type="checkbox" />
                </div>
                <div>
                    Update packets with ignored/resolved alerts to Passed Error Checks
                </div>
            </div>
            <div class="pt-4">
                <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    Import
                </button>
                <a href="/Packets/Index" class="rounded-md bg-gray-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-gray-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600">
                    Cancel
                </a>
            </div>
        </div>
    </form>
</turbo-frame>