@page
@model UDS.Net.Forms.Pages.BulkErrorImport.CreateModel

@{
    var SubmissionErrorIndex = 0;
}

<turbo-frame id="BulkErrorImport">
    <form method="post" asp-page-handler="ConfirmBulkImport">
        <div class="flex justify-center py-3">
            <div asp-validation-summary="All" class="mt-2 text-sm text-red-600"></div>
        </div>
        <div class="grid grid-cols-4">
            <div class="col-start-2 col-span-2">
                <div class="grid grid-cols-1 p-3 rounded-md min-h-16 bg-gray-200 px-3 py-2 text-sm font-semibold text-black shadow-sm">
                <div class="pb-3">
                    Packets in Submitted Status
                </div>
                    @foreach (var packet in Model.PacketsToDisplay)

                    {

                        var activeSubmission = packet.GetActiveSubmission;

                    <div class="py-3">
                        <div class="border border-gray-600 grid grid-cols-3 p-4 bg-white">
                            <div>
                                <input type="checkbox" />
                            </div>
                            <div>
                                PTID: @packet.PacketToImport.ParticipationId @(activeSubmission.ErrorCount > 0 ? $"Error Count: {@activeSubmission.ErrorCount}" : "")
                            </div>
                            <div>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                </svg>
                            </div>
                        </div>

                        @foreach(var error in activeSubmission.Errors)
                        {

                            /*
                                id: 0,
                                packetSubmissionId: packet.Submissions.Last().Id,
                                formKind: error.Code.Split("-")[0].ToUpper(),
                                message: error.Message,
                                assignedTo: packet.CreatedBy,
                                level: GetErrorLevel(error.Type),
                                status: PacketSubmissionErrorStatus.Pending,
                                statusChangedBy: null,
                                createdAt: DateTime.Now,
                                createdBy: User.Identity.Name,
                                modifiedBy: null,
                                deletedBy: null,
                                isDeleted: false,
                                location: error.Location?.ToUpper(),
                                value: error.Value
                            */

                            <div class="border border-gray-400">
                                <div class="grid grid-cols-2 bg-white py-5 pl-3">
                                    <div>
                                        @error.FormKind - @error.Location
                                    </div>
                                </div>

                                <div class="grid grid-cols-3 bg-white py-5 pl-3">
                                    <div>
                                        Error Level: @error.Level
                                    </div>
                                    <div>
                                        Error Value: @error.Value
                                    </div>
                                    <div>
                                        Assigned To: @error.AssignedTo
                                    </div>
                                </div>
                            
                                <div class="grid grid-cols-2 bg-white py-5 pl-3">
                                    <div>
                                        @error.Message
                                    </div>
                                    <div>
                                        <select readonly name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.Status" value="@error.Status">
                                            <option value="0">Pending</option>
                                            <option value="1">Resolved</option>
                                            <option value="2">Ignored</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                             @* hidden  inputs for the NACC errors *@
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.Id" value="@error.Id" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.PacketSubmissionId" value="@error.PacketSubmissionId" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.FormKind" value="@error.FormKind" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.Message" value="@error.Message" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.AssignedTo" value="@error.AssignedTo" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.Level" value="@error.Level" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.StatusChangedBy" value="@error.StatusChangedBy" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.Location" value="@error.Location" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.Value" value="@error.Value" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.CreatedAt" value="@error.CreatedAt" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.CreatedBy" value="@error.CreatedBy" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.ModifiedBy" value="@error.ModifiedBy" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.DeletedBy" value="@error.DeletedBy" />
                            <input type="hidden" name="SubmissionErrors[@SubmissionErrorIndex].SubmissionError.IsDeleted" value="@error.IsDeleted" />

                            @* increment the NACCErrorIndex *@
                            SubmissionErrorIndex++;
                        } 
                    </div>
                }
                <div class="pt-4 flex gap-x-3">
                    <div>
                        <input type="checkbox" />
                    </div>
                    <div>
                        Update packets to PassedErrorChecks with all alerts set to ignored/resolved
                    </div>
                </div>
                <div class="pt-4">
                    <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                        Import
                    </button>
                    <a href="/Packets/Index" class="rounded-md bg-gray-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-gray-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600">
                        Cancel
                    </a>
                </div>
            </div>
            </div>
        </div>
    </form>
</turbo-frame>