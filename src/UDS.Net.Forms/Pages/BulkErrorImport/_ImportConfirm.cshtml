@model BulkImportConfirmViewModel
@{
    var bulkErrorSubmissionItemIndex = 0;
}

<turbo-frame id="BulkErrorImport">
    <form method="post" asp-page-handler="ConfirmBulkImport" data-controller="bulkImport">
        <div class="px-16 py-3">
            <div class="p-3 flex justify-end gap-5">
                <a class="p-3 flex rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" data-action="click->bulkImport#ToggleWindows" data-bulkImport-open-windows-param="true">
                    <div>
                        Open All 
                    </div>
                    <div>
                        <span>
                            <svg class="w-6 h-6 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7" /></svg>
                        </span>
                    </div>
                </a>
                <a class="p-3 flex rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" data-action="click->bulkImport#ToggleWindows" data-bulkImport-open-windows-param="false">
                    <div>
                        Collapse All
                    </div>
                    <div>
                        <span>
                            <svg class="w-6 h-6 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 15 7-7 7 7" /></svg>
                        </span>
                    </div>
                </a>
            </div>
            <div class="grid grid-cols-1 p-3 rounded-md min-h-16 bg-gray-200 px-3 py-2 text-sm font-semibold text-black shadow-sm">
                <div class="pb-3">
                    Packets Updated
                </div>
                @foreach (var packet in Model.UpdatedPackets)
                {
                    var activeSubmission = packet.Submissions.Last();

                    <div class="py-3">
                        <div class="border border-gray-600 flex p-4 bg-white">
                            <div class="w-14"></div>
                            <div class="w-64">
                                <a class="text-indigo-600 hover:underline"
                                   target="_blank"
                                   asp-page="/Participations/Details"
                                   asp-route-id="@packet.ParticipationId">
                                    PTID: @packet.ParticipationId
                                </a>
                            </div>
                             <div class="w-64">
                                <a class="text-indigo-600 hover:underline"
                                   target="_blank"
                                   asp-page="/Visits/Details"
                                   asp-route-id="@packet.Id">
                                    Visit: @packet.VISITNUM
                                </a>
                            </div>
                             <div class="w-64">
                                Packet: @packet.PACKET
                            </div>
                            <div class="w-64">
                                @(activeSubmission.ErrorCount > 0 ? $"Error Count: {@activeSubmission.ErrorCount}" : "")
                            </div>
                            <div class="w-64">
                                <a class="text-indigo-600 hover:underline" asp-page="/Packets/Details" asp-route-id="@packet.Id" target="_blank">Packet updated to - @packet.Status</a>
                            </div>
                            <div class="flex-1 flex justify-end" data-action="click->bulkImport#ToggleErrorDisplay" data-bulkImport-submission-index-param="@bulkErrorSubmissionItemIndex">
                                <span>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                    </svg>
                                </span>
                            </div>
                        </div>

                        @if (activeSubmission.ErrorCount > 0)
                        {
                            <div class="mt-3 py-5 px-5 bg-white" data-bulkImport-target="window" data-submission-index="@bulkErrorSubmissionItemIndex" hidden>
                                <table class="w-full">
                                    <thead>
                                        <tr class="text-left">
                                            <th>Code</th>
                                            <th>Location</th>
                                            <th>Message</th>
                                            <th>Value</th>
                                            <th>Level</th>
                                            <th>Status</th>
                                            <th>Time Stamp</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var error in activeSubmission.Errors)
                                        {
                                            <tr>
                                                <td>@error.ErrorCode</td>
                                                <td class="py-5">@error.FormKind - @error.Location</td>
                                                <td class="py-5">@error.Message</td>
                                                <td class="py-5">@error.Value</td>
                                                <td class="py-5">
                                                    <div class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium @(error.Level.ToString().ToLower() == "error" ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800")">
                                                        @error.Level
                                                    </div>
                                                </td>
                                                <td class="py-5">
                                                    @error.Status
                                                </td>
                                                <td>@error.ErrorTimeStamp</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    bulkErrorSubmissionItemIndex++;
                }
            </div>
            <div class="mt-10 grid grid-cols-1 p-3 rounded-md min-h-16 bg-gray-200 px-3 py-5 text-sm font-semibold text-black shadow-sm">
                <div class="pb-3">
                    Packets still in Submitted status
                </div>
                @foreach (var packet in Model.UnmodifiedPackets)
                {
                    <div class="py-3">
                        <div class="border border-gray-600 flex p-4 bg-white">
                            <div class="w-14"></div>
                            <div class="w-64">
                                <a class="text-indigo-600 hover:underline"
                                   target="_blank"
                                   asp-page="/Participations/Details"
                                   asp-route-id="@packet.ParticipationId">
                                    PTID: @packet.ParticipationId
                                </a>
                            </div>
                            <div class="w-64">
                                <a class="text-indigo-600 hover:underline"
                                   target="_blank"
                                   asp-page="/Visits/Details"
                                   asp-route-id="@packet.Id">
                                    Visit: @packet.VISITNUM
                                </a>
                            </div>
                             <div class="w-64">
                                Packet: @packet.PACKET
                            </div>
                            <div class="w-64">
                                <a class="text-indigo-600 hover:underline" asp-page="/Packets/Details" asp-route-id="@packet.Id" target="_blank">Packet status - @packet.Status</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="pt-4">
                <a asp-page="/Packets/Index" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    To packet submissions
                </a>
            </div>
        </div>
    </form>
</turbo-frame>